{
  "name": "dsh-skills-manager",
  "version": "1.0.0",
  "description": "Skill manager for DeepSeek Harness: proactive skill activation with trigger hooks, GitHub source sync, and a Settings management UI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "skill",
    "skills",
    "hooks",
    "github"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./lib.js": "./lib.js"
  },
  "files": [
    "index.js",
    "lib.js",
    "client/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "scripts": {
    "test": "node --test test.mjs package-contract.test.mjs",
    "test:unit": "node --test test.mjs",
    "test:package": "node --test package-contract.test.mjs",
    "lint": "node --check index.js && node --check lib.js && node --check client/client.js && node --check test.mjs && node --check package-contract.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
